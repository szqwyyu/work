@{
    ViewData["Title"] = "PetShop — Каталог товаров";
}
<main class="container">
    <section id="services" class="section services-section">
        <h2 class="section-title">Наши товары</h2>

        <div class="services-wrapper">
            <button class="arrow left" id="services-left" aria-label="Влево">&#8249;</button>

            <div class="services-track" id="services-track" role="list">
                <!-- 1 -->
                <article class="service-card" role="listitem">
                    <img src="/images/pet-food.jpg" alt="Корма для животных" class="service-img" />
                    <h3 class="service-title">Корма для животных</h3>
                    <p class="service-desc">Полноценные и сбалансированные корма для кошек, собак, грызунов и птиц.</p>
                </article>

                <!-- 2 -->
                <article class="service-card" role="listitem">
                    <img src="/images/pet-accessories.jpg" alt="Аксессуары" class="service-img" />
                    <h3 class="service-title">Аксессуары</h3>
                    <p class="service-desc">Миски, переноски, поводки, игрушки и другие удобные вещи для питомцев.</p>
                </article>

                <!-- 3 -->
                <article class="service-card" role="listitem">
                    <img src="/images/pet-care.jpg" alt="Уход и гигиена" class="service-img" />
                    <h3 class="service-title">Уход и гигиена</h3>
                    <p class="service-desc">Средства по уходу: шампуни, расчёски, когтерезы, гигиенические принадлежности.</p>
                </article>

                <!-- 4 -->
                <article class="service-card" role="listitem">
                    <img src="/images/pet-houses.jpg" alt="Домики и лежанки" class="service-img" />
                    <h3 class="service-title">Домики и лежанки</h3>
                    <p class="service-desc">Комфортные места отдыха для ваших питомцев — от простых подстилок до стильных домиков.</p>
                </article>

                <!-- 5 -->
                <article class="service-card" role="listitem">
                    <img src="/images/pet-clothes.jpg" alt="Одежда для питомцев" class="service-img" />
                    <h3 class="service-title">Одежда для питомцев</h3>
                    <p class="service-desc">Костюмы, свитера, дождевики и обувь — всё, чтобы питомцу было уютно и стильно.</p>
                </article>

                <!-- 6 -->
                <article class="service-card" role="listitem">
                    <img src="/images/vet-products.jpg" alt="Ветеринарные товары" class="service-img" />
                    <h3 class="service-title">Ветеринарные товары</h3>
                    <p class="service-desc">Витамины, препараты и средства для здоровья ваших питомцев.</p>
                </article>
            </div>

            <button class="arrow right" id="services-right" aria-label="Вправо">&#8250;</button>
        </div>
    </section>
</main>
