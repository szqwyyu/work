<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Зоомагазин "Питомец"</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-paw"></i> Питомец
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/">Главная</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">Товары</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Services" asp-action="Index">Услуги</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/About">О нас</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Contact">Контакты</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <span class="nav-link">Привет, @User.Identity.Name!</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Account/Logout">Выйти</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <button class="nav-link btn btn-link" onclick="openLoginModal()" style="border: none; background: none; color: rgba(255,255,255,0.75);">
                                    Войти
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link btn btn-link" onclick="openRegisterModal()" style="border: none; background: none; color: rgba(255,255,255,0.75);">
                                    Регистрация
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="bg-dark text-light mt-5">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-4">
                    <h5><i class="fas fa-paw"></i> Зоомагазин "Питомец"</h5>
                    <p>Лучшие товары и услуги для ваших домашних любимцев.</p>
                </div>
                <div class="col-md-4">
                    <h5>Контакты</h5>
                    <p><i class="fas fa-phone"></i> +7 (999) 123-45-67</p>
                    <p><i class="fas fa-envelope"></i> info@petshop.ru</p>
                    <p><i class="fas fa-map-marker-alt"></i> г. Москва, ул. Пушкина, д. 1</p>
                </div>
                <div class="col-md-4">
                    <h5>Мы в соцсетях</h5>
                    <div class="social-links">
                        <a href="#" class="text-light me-3"><i class="fab fa-vk fa-2x"></i></a>
                        <a href="#" class="text-light me-3"><i class="fab fa-telegram fa-2x"></i></a>
                        <a href="#" class="text-light"><i class="fab fa-instagram fa-2x"></i></a>
                    </div>
                </div>
            </div>
            <div class="text-center mt-4">
                <p>&copy; 2024 Зоомагазин "Питомец". Все права защищены.</p>
            </div>
        </div>
    </footer>

    <!-- Модальное окно входа -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content login-modal-content">
                <div class="modal-header">
                    <div class="brand-logo text-center w-100">
                        <i class="fas fa-paw"></i>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <h2 class="modal-title text-center mb-3">Вход в систему</h2>
                    <p class="text-center text-muted mb-4">Добро пожаловать обратно!</p>

                    <form id="loginForm">
                        <div class="form-group mb-3">
                            <label for="loginUsername" class="form-label">
                                <i class="fas fa-user me-2"></i>Имя пользователя
                            </label>
                            <input type="text" class="form-control" id="loginUsername" name="username"
                                   placeholder="Введите ваше имя пользователя" required>
                        </div>

                        <div class="form-group mb-3">
                            <label for="loginPassword" class="form-label">
                                <i class="fas fa-lock me-2"></i>Пароль
                            </label>
                            <div class="password-container position-relative">
                                <input type="password" class="form-control" id="loginPassword" name="password"
                                       placeholder="Введите ваш пароль" required>
                                <button type="button" class="btn password-toggle" id="loginPasswordToggle">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-options d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="loginRememberMe">
                                <label class="form-check-label" for="loginRememberMe">
                                    Запомнить меня
                                </label>
                            </div>
                            <a href="#" class="forgot-password">Забыли пароль?</a>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 btn-login">
                            <i class="fas fa-sign-in-alt me-2"></i>Войти в систему
                        </button>
                    </form>

                    <div id="loginMessage" class="mt-3"></div>

                    <div class="login-divider my-4">
                        <span>Нет аккаунта?</span>
                    </div>

                    <div class="register-section text-center">
                        <p class="register-text mb-3">Присоединяйтесь к нашему сообществу</p>
                        <button type="button" class="btn btn-outline-primary w-100" onclick="switchToRegister()">
                            <i class="fas fa-user-plus me-2"></i>Создать аккаунт
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Модальное окно регистрации -->
    <div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content register-modal-content">
                <div class="modal-header">
                    <div class="brand-logo text-center w-100">
                        <i class="fas fa-paw"></i>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <h2 class="modal-title text-center mb-3">Создать аккаунт</h2>
                    <p class="text-center text-muted mb-4">Присоединяйтесь к нашему сообществу</p>

                    <form id="registerForm">
                        <div class="form-group mb-3">
                            <label for="registerUsername" class="form-label">
                                <i class="fas fa-user me-2"></i>Имя пользователя
                            </label>
                            <input type="text" class="form-control" id="registerUsername" name="username"
                                   placeholder="Придумайте имя пользователя" required>
                        </div>

                        <div class="form-group mb-3">
                            <label for="registerEmail" class="form-label">
                                <i class="fas fa-envelope me-2"></i>Email
                            </label>
                            <input type="email" class="form-control" id="registerEmail" name="email"
                                   placeholder="Введите ваш email" required>
                        </div>

                        <div class="form-group mb-3">
                            <label for="registerPassword" class="form-label">
                                <i class="fas fa-lock me-2"></i>Пароль
                            </label>
                            <div class="password-container position-relative">
                                <input type="password" class="form-control" id="registerPassword" name="password"
                                       placeholder="Придумайте пароль" required>
                                <button type="button" class="btn password-toggle" id="registerPasswordToggle">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label for="registerConfirmPassword" class="form-label">
                                <i class="fas fa-lock me-2"></i>Подтвердите пароль
                            </label>
                            <div class="password-container position-relative">
                                <input type="password" class="form-control" id="registerConfirmPassword" name="confirmPassword"
                                       placeholder="Повторите пароль" required>
                                <button type="button" class="btn password-toggle" id="registerConfirmPasswordToggle">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="form-check mb-4">
                            <input type="checkbox" class="form-check-input" id="registerAgree" required>
                            <label class="form-check-label" for="registerAgree">
                                Я соглашаюсь с <a href="#" class="text-primary">условиями использования</a> и <a href="#" class="text-primary">политикой конфиденциальности</a>
                            </label>
                        </div>

                        <button type="submit" class="btn btn-success w-100 btn-register">
                            <i class="fas fa-user-plus me-2"></i>Создать аккаунт
                        </button>
                    </form>

                    <div id="registerMessage" class="mt-3"></div>

                    <div class="login-divider my-4">
                        <span>Уже есть аккаунт?</span>
                    </div>

                    <div class="login-section text-center">
                        <p class="login-text mb-3">Войдите в существующий аккаунт</p>
                        <button type="button" class="btn btn-outline-success w-100" onclick="switchToLogin()">
                            <i class="fas fa-sign-in-alt me-2"></i>Войти в систему
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Функция открытия модального окна входа
        function openLoginModal() {
            const loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
            loginModal.show();
        }

        // Функция открытия модального окна регистрации
        function openRegisterModal() {
            const registerModal = new bootstrap.Modal(document.getElementById('registerModal'));
            registerModal.show();
        }

        // Переключение с регистрации на вход
        function switchToLogin() {
            const registerModal = bootstrap.Modal.getInstance(document.getElementById('registerModal'));
            registerModal.hide();

            setTimeout(() => {
                openLoginModal();
            }, 300);
        }

        // Переключение с входа на регистрацию
        function switchToRegister() {
            const loginModal = bootstrap.Modal.getInstance(document.getElementById('loginModal'));
            loginModal.hide();

            setTimeout(() => {
                openRegisterModal();
            }, 300);
        }

        // Инициализация модальных окон
        document.addEventListener('DOMContentLoaded', function () {
            initializeLoginModal();
            initializeRegisterModal();
        });

        function initializeLoginModal() {
            const loginForm = document.getElementById('loginForm');
            const passwordToggle = document.getElementById('loginPasswordToggle');
            const passwordInput = document.getElementById('loginPassword');
            const loginMessage = document.getElementById('loginMessage');

            if (!loginForm) return;

            // Переключение видимости пароля
            if (passwordToggle && passwordInput) {
                passwordToggle.addEventListener('click', function () {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    this.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
                });
            }

            // Обработка формы входа
            loginForm.addEventListener('submit', async function (e) {
                e.preventDefault();

                const formData = {
                    username: document.getElementById('loginUsername').value,
                    password: document.getElementById('loginPassword').value,
                    rememberMe: document.getElementById('loginRememberMe').checked
                };

                // Показываем индикатор загрузки
                const submitBtn = loginForm.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '';
                submitBtn.classList.add('loading');
                submitBtn.disabled = true;

                try {
                    const response = await fetch('/Account/Login', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(formData)
                    });

                    const result = await response.json();

                    if (result.success) {
                        loginMessage.innerHTML = `<div class="alert alert-success">
                                <i class="fas fa-check-circle me-2"></i>Успешный вход! Перенаправление...
                            </div>`;

                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        loginMessage.innerHTML = `<div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle me-2"></i>${result.message}
                            </div>`;
                    }
                } catch (error) {
                    console.error('Error:', error);
                    loginMessage.innerHTML = `<div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>Произошла ошибка при входе. Попробуйте ещё раз.
                        </div>`;
                } finally {
                    // Восстанавливаем кнопку
                    submitBtn.innerHTML = originalText;
                    submitBtn.classList.remove('loading');
                    submitBtn.disabled = false;
                }
            });

            // Очистка сообщений при закрытии модального окна
            const loginModal = document.getElementById('loginModal');
            if (loginModal) {
                loginModal.addEventListener('hidden.bs.modal', function () {
                    if (loginMessage) loginMessage.innerHTML = '';
                    if (loginForm) loginForm.reset();
                });
            }
        }

        function initializeRegisterModal() {
            const registerForm = document.getElementById('registerForm');
            const passwordToggle = document.getElementById('registerPasswordToggle');
            const passwordInput = document.getElementById('registerPassword');
            const confirmPasswordToggle = document.getElementById('registerConfirmPasswordToggle');
            const confirmPasswordInput = document.getElementById('registerConfirmPassword');
            const registerMessage = document.getElementById('registerMessage');

            if (!registerForm) return;

            // Переключение видимости пароля
            if (passwordToggle && passwordInput) {
                passwordToggle.addEventListener('click', function () {
                    const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    passwordInput.setAttribute('type', type);
                    this.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
                });
            }

            // Переключение видимости подтверждения пароля
            if (confirmPasswordToggle && confirmPasswordInput) {
                confirmPasswordToggle.addEventListener('click', function () {
                    const type = confirmPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                    confirmPasswordInput.setAttribute('type', type);
                    this.innerHTML = type === 'password' ? '<i class="fas fa-eye"></i>' : '<i class="fas fa-eye-slash"></i>';
                });
            }

            // Обработка формы регистрации
            registerForm.addEventListener('submit', async function (e) {
                e.preventDefault();

                const password = document.getElementById('registerPassword').value;
                const confirmPassword = document.getElementById('registerConfirmPassword').value;

                // Проверка совпадения паролей
                if (password !== confirmPassword) {
                    registerMessage.innerHTML = `<div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>Пароли не совпадают
                        </div>`;
                    return;
                }

                // Проверка согласия с условиями
                if (!document.getElementById('registerAgree').checked) {
                    registerMessage.innerHTML = `<div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>Необходимо согласие с условиями использования
                        </div>`;
                    return;
                }

                const formData = {
                    username: document.getElementById('registerUsername').value,
                    email: document.getElementById('registerEmail').value,
                    password: password
                };

                // Показываем индикатор загрузки
                const submitBtn = registerForm.querySelector('button[type="submit"]');
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML = '';
                submitBtn.classList.add('loading');
                submitBtn.disabled = true;

                try {
                    const response = await fetch('/Account/Register', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify(formData)
                    });

                    const result = await response.json();

                    if (result.success) {
                        registerMessage.innerHTML = `<div class="alert alert-success">
                                <i class="fas fa-check-circle me-2"></i>${result.message} Перенаправление на вход...
                            </div>`;

                        setTimeout(() => {
                            const registerModal = bootstrap.Modal.getInstance(document.getElementById('registerModal'));
                            registerModal.hide();
                            setTimeout(() => {
                                openLoginModal();
                            }, 300);
                        }, 2000);
                    } else {
                        registerMessage.innerHTML = `<div class="alert alert-danger">
                                <i class="fas fa-exclamation-triangle me-2"></i>${result.message}
                            </div>`;
                    }
                } catch (error) {
                    console.error('Error:', error);
                    registerMessage.innerHTML = `<div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>Произошла ошибка при регистрации. Попробуйте ещё раз.
                        </div>`;
                } finally {
                    // Восстанавливаем кнопку
                    submitBtn.innerHTML = originalText;
                    submitBtn.classList.remove('loading');
                    submitBtn.disabled = false;
                }
            });

            // Очистка сообщений при закрытии модального окна
            const registerModal = document.getElementById('registerModal');
            if (registerModal) {
                registerModal.addEventListener('hidden.bs.modal', function () {
                    if (registerMessage) registerMessage.innerHTML = '';
                    if (registerForm) registerForm.reset();
                });
            }
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>